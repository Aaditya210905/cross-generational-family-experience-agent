# Qloo API (Person A manages, but needed for pipeline)
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM Provider (Person B manages)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: change base URL for Gemini, Groq, OpenRouter, Ollama, etc.
# Examples:
#   OpenAI:       https://api.openai.com/v1 (default if unset)
#   Gemini:       https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:         https://api.groq.com/openai/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Local Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# App Config
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# Scoring Defaults
BLEND_RATIO=0.7
BRIDGE_BONUS_WEIGHT=0.05
DIVERSITY_THRESHOLD=0.7
MIN_SATISFACTION_FLOOR=0.15
